{
  "name": "ensemble-workflows",
  "version": "0.0.0",
  "description": "Deterministic multi-engine orchestration harness for Codex, Claude, opencode, and cross-engine verification.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "ensemble": "./dist/src/cli/ensemble.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:skill",
    "build:skill": "node scripts/build-skill.mjs",
    "sync:skill": "npm run build:skill && cp -R skills/ensemble-workflow/. \"$HOME/.claude/skills/ensemble-workflow/\"",
    "lint": "eslint .",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "test:live": "npm run build && ENSEMBLE_LIVE=1 node --test \"dist/test/live/**/*.test.js\""
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "esbuild": "0.28.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  }
}
