{
  "name": "ensemble-workflows",
  "version": "0.0.1",
  "description": "Deterministic multi-engine orchestration harness for Codex, Claude, opencode, and cross-engine verification.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "ensemble": "./dist/src/cli/ensemble.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:skill",
    "build:skill": "node scripts/build-skill.mjs",
    "lint": "eslint src test scripts eslint.config.js",
    "test": "npm run build && node scripts/run-test-suite.mjs",
    "test:live": "npm run build && ENSEMBLE_LIVE=1 node scripts/run-test-suite.mjs \"dist/test/live/**/*.test.js\""
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "dependencies": {
    "acorn": "8.17.0",
    "acorn-globals": "7.0.1",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "esbuild": "0.28.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  }
}
